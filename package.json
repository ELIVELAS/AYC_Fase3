{
  "name": "ayc-compilador",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Compilador de pseudoc\u00f3digo a JavaScript y Python",
  "scripts": {
    "start": "node src/index.js",
    "ui": "node src/server.js",
